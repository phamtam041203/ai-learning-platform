graph erd_core {
	layout=neato overlap=false splines=true
	node [color="#64748b" fillcolor="#f8fafc" fontsize=10 shape=record style=filled]
	USERS [label="{USERS|id PK|email|role|full_name}"]
	STUDENT_PROFILES [label="{STUDENT_PROFILES|id PK|user_id FK|student_id|major|specialization}"]
	TEACHER_PROFILES [label="{TEACHER_PROFILES|id PK|user_id FK|teacher_id|department}"]
	COURSES [label="{COURSES|id PK|teacher_id FK|course_code|course_name}"]
	LESSONS [label="{LESSONS|id PK|course_id FK|title|order}"]
	ENROLLMENTS [label="{ENROLLMENTS|id PK|student_id FK|course_id FK|status|total_score}"]
	LESSON_PROGRESS [label="{LESSON_PROGRESS|id PK|student_id FK|lesson_id FK|is_completed}"]
	ASSESSMENTS [label="{ASSESSMENTS|id PK|course_id FK|title|assessment_type}"]
	QUESTIONS [label="{QUESTIONS|id PK|assessment_id FK|question_text}"]
	SUBMISSIONS [label="{SUBMISSIONS|id PK|assessment_id FK|student_id FK|score}"]
	QUIZ_RESULTS [label="{QUIZ_RESULTS|id PK|user_id FK|lesson_id FK|score}"]
	ESSAY_SUBMISSIONS [label="{ESSAY_SUBMISSIONS|id PK|lesson_id FK|student_id FK|course_id FK|score}"]
	RECOMMENDATIONS [label="{RECOMMENDATIONS|id PK|student_id FK|recommendation_type|confidence_score}"]
	STUDENT_SKILL_PROFILES [label="{STUDENT_SKILL_PROFILES|id PK|student_id FK|skill_id|confidence}"]
	USERS -- STUDENT_PROFILES [label="1-0..1"]
	USERS -- TEACHER_PROFILES [label="1-0..1"]
	USERS -- COURSES [label="1-N teaches"]
	USERS -- ENROLLMENTS [label="1-N student"]
	COURSES -- LESSONS [label="1-N"]
	COURSES -- ENROLLMENTS [label="1-N"]
	COURSES -- ASSESSMENTS [label="1-N"]
	LESSONS -- LESSON_PROGRESS [label="1-N"]
	LESSONS -- QUIZ_RESULTS [label="1-N"]
	LESSONS -- ESSAY_SUBMISSIONS [label="1-N"]
	ASSESSMENTS -- QUESTIONS [label="1-N"]
	ASSESSMENTS -- SUBMISSIONS [label="1-N"]
	USERS -- SUBMISSIONS [label="1-N student"]
	USERS -- QUIZ_RESULTS [label="1-N"]
	USERS -- ESSAY_SUBMISSIONS [label="1-N"]
	USERS -- RECOMMENDATIONS [label="1-N"]
	USERS -- STUDENT_SKILL_PROFILES [label="1-N"]
}
